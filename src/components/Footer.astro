---
const today = new Date();
import Email from '../assets/socials/envelope.svg';
import Github from '../assets/socials/github.svg';
import Linkedin from '../assets/socials/linkedin.svg';
---

<footer>
	&copy; {today.getFullYear()} Adam Jones. All rights reserved.
	<div class="social-links">
		<a href="mailto:work@adam-jones.me" target="_blank">
			<span class="sr-only">Email me</span>
			<Email />
		</a>
		<a href="https://www.linkedin.com/in/adm-j/" target="_blank">
			<span class="sr-only">Connect with me on Linkedin</span>
			<Linkedin />
		</a>
		<a href="https://github.com/adm-j" target="_blank">
			<span class="sr-only">Check out my github</span>
			<Github />
		</a>
	</div>
</footer>
<style>
	footer {
		padding: 2em 1em 4em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	.social-links {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 1.25em;
		margin-top: 1.25em;
	}
	.social-links a {
		display: inline-flex;
		padding: 0.4em;
		border-radius: 8px;
		text-decoration: none;
		color: rgb(var(--gray));
		transition: transform 0.2s ease, color 0.2s ease;
	}
	.social-links a:hover {
		transform: translateY(-2px);
		color: rgb(var(--gray-dark));
	}
	.social-links svg {
		width: 2em;
		height: 2em;
	}
</style>
